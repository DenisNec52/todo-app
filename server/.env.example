PORT=5000
MONGO_URI=mongodb://localhost:27017/todo_app
# Obbligatoria: il server non si avvia senza. Usa una stringa lunga e casuale.
JWT_SECRET=cambia-questa-stringa-con-una-lunga-e-casuale
CLIENT_URL=http://localhost:5173

# URL pubblico del frontend, usato nei link delle mail (reset password)
APP_URL=http://localhost:5173

# Invio mail (opzionale). Senza SMTP_HOST le mail vengono solo scritte nei log.
# Esempio Brevo: smtp-relay.brevo.com / 587 / login SMTP e chiave SMTP dal pannello.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Todo App <tuo-mittente-verificato@esempio.com>"
